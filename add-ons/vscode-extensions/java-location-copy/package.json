{
  "name": "java-location-copy",
  "displayName": "java-location-copy",
  "description": "Java location copy",
  "version": "0.0.1",
  "publisher": "sudo-yoko",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudo-yoko/portfolio-java.git"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "java-location-copy.copyMetadata",
        "category": "Java Location Copy",
        "title": "メソッド情報をクリップボードにコピー"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "java-location-copy.copyMetadata",
          "when": "editorTextFocus",
          "group": "copy"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
